{% extends 'base.html.twig' %}

{% block title %}Login | Panel Admin{% endblock %}

{% block body %}

    <section class="min-h-screen flex items-center justify-center bg-black text-white px-4 mt-20">

        <!-- CONTENEDOR -->
        <div class="w-full max-w-md bg-gray-900 rounded-2xl shadow-2xl p-8 border border-gray-800">

            <!-- LOGO / TITULO -->
            <h1 class="text-3xl font-bold text-center mb-2 tracking-wide">
                Panel Admin
            </h1>

            <p class="text-center text-gray-400 mb-6 text-sm">
                Uli y los Cómplices Fantasmas
            </p>

            <!-- ERROR -->
            {% if error %}
                <div class="mb-4 p-3 bg-red-500/20 border border-red-500 text-red-400 rounded-lg text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <!-- YA LOGUEADO -->
            {% if app.user %}
                <div class="mb-4 text-sm text-green-400 text-center">
                    Ya estás logueado como {{ app.user.userIdentifier }}
                </div>
            {% endif %}

            <!-- FORM -->
            <form method="post" class="space-y-5">

                <!-- EMAIL -->
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Email</label>
                    <input type="email" name="email" value="{{ last_username }}"
                        class="w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500 transition"
                        required autofocus>
                </div>

                <!-- PASSWORD -->
                <div>
                    <label class="block text-sm text-gray-400 mb-1">Contraseña</label>
                    <input type="password" name="password"
                        class="w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500 transition"
                        required>
                </div>

                <!-- CSRF -->
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <!-- REMEMBER -->
                <div class="flex items-center justify-between text-sm">
                    <label class="flex items-center gap-2 text-gray-400">
                        <input type="checkbox" name="_remember_me" class="accent-purple-600">
                        Recordarme
                    </label>
                </div>

                <!-- BOTON -->
                <button type="submit"
                    class="w-full bg-purple-600 hover:bg-purple-700 transition py-3 rounded-lg font-semibold shadow-lg">
                    Ingresar
                </button>

            </form>

            <!-- VOLVER -->
            <div class="mt-6 text-center">
                <a href="/" class="text-sm text-purple-400 hover:text-purple-300 transition">
                    ← Volver al sitio
                </a>
            </div>

        </div>

    </section>

{% endblock %}