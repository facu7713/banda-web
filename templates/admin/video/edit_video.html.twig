{% extends 'base_admin.html.twig' %}

{% block body %}

    <section class="min-h-screen bg-black text-white px-4 md:px-8 py-10">

        <div class="max-w-2xl mx-auto">

            <!-- VOLVER -->
            <a href="{{ path('admin_video') }}"
                class="text-purple-400 hover:text-purple-300 transition mb-6 inline-block">
                ← Volver a videos
            </a>

            <!-- TITULO -->
            <h1 class="text-3xl md:text-4xl font-bold mb-8">
                Editar Video
            </h1>

            <!-- PREVIEW 🔥 -->
            {% if video.url %}
                {% set videoId = video.url|replace({
                    'https://www.youtube.com/watch?v=': '',
                    'https://youtu.be/': ''
                })|split('&')[0] %}

                <div class="mb-8">
                    <p class="text-sm text-gray-400 mb-2">Vista previa:</p>

                    <iframe 
                        class="w-full h-64 rounded-lg border border-gray-700"
                        src="https://www.youtube.com/embed/{{ videoId }}"
                        frameborder="0"
                        allowfullscreen>
                    </iframe>
                </div>
            {% endif %}

            <!-- FORM -->
            <div class="bg-gray-900 p-6 rounded-xl shadow-lg border border-gray-800">

                {{ form_start(form) }}

                    <!-- NOMBRE -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">Nombre</label>
                        {{ form_widget(form.nombre, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- URL -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">URL de YouTube</label>
                        {{ form_widget(form.url, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}

                        <p class="text-xs text-gray-500 mt-1">
                            Ej: https://www.youtube.com/watch?v=XXXX
                        </p>
                    </div>

                    <!-- INFO -->
                    <div class="mb-6">
                        <label class="block mb-2 text-sm text-gray-400">Descripción</label>
                        {{ form_widget(form.info, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- BOTON -->
                    <button
                        class="w-full bg-gradient-to-r from-purple-500 to-pink-500 py-3 rounded-lg font-semibold text-lg hover:scale-105 transition-all duration-300 shadow-lg">
                        Guardar Cambios
                    </button>

                {{ form_end(form) }}

            </div>

        </div>

    </section>

{% endblock %}