{% extends 'base_admin.html.twig' %}

{% block title %}Admin | Uli y los Cómplices Fantasmas{% endblock %}

{% block body %}

    <section class="min-h-screen bg-gradient-to-b from-black via-gray-950 to-black text-white px-6 py-12">

        <div class="max-w-6xl mx-auto">

            <!-- VOLVER -->
            <a href="{{ path('app_logout') }}" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg text-sm mb-6 inline-block transition">
                ← Cerrar sesión 
            </a> 

            <!-- TITULO -->
            <div class="text-center mb-12">
                <h1 class="text-3xl md:text-5xl font-extrabold tracking-wide mb-2">
                    Panel de Administración
                </h1>
                <p class="text-gray-400 text-sm md:text-base">
                    Gestioná el contenido de la banda de forma simple y rápida
                </p>
            </div>

            <!-- GRID -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">

                <!-- CARD -->
                {% set cards = [
                    { titulo: 'Shows', icono: '🎤', desc: 'Eventos en vivo', ruta: 'admin_show' },
                    { titulo: 'Canciones', icono: '🎧', desc: 'Demos y repertorio', ruta: 'admin_cancion' },
                    { titulo: 'Videos', icono: '📺', desc: 'Contenido audiovisual', ruta: 'admin_video' },
                    { titulo: 'Fotos', icono: '📸', desc: 'Galería de imágenes', ruta: 'admin_foto' },
                    { titulo: 'Comentarios', icono: '☰', desc: 'Comentarios de los usuarios', ruta: 'admin_comentarios' }
                ] %}

                {% for card in cards %}
                    <a href="{{ path(card.ruta) }}"
                    class="group relative bg-gray-900/80 backdrop-blur rounded-2xl p-6 text-center
                            border border-gray-800 hover:border-purple-500
                            shadow-lg hover:shadow-purple-500/20
                            transition-all duration-300 hover:scale-105 overflow-hidden">

                        <!-- glow -->
                        <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 via-purple-600/0 to-purple-600/20 opacity-0 group-hover:opacity-100 transition"></div>

                        <!-- icono -->
                        <div class="text-4xl mb-3 group-hover:scale-110 transition">
                            {{ card.icono }}
                        </div>

                        <!-- titulo -->
                        <h2 class="text-xl font-semibold mb-1">
                            {{ card.titulo }}
                        </h2>

                        <!-- descripcion -->
                        <p class="text-sm text-gray-400">
                            {{ card.desc }}
                        </p>

                    </a>
                {% endfor %}

            </div>

        </div>

    </section>

{% endblock %}