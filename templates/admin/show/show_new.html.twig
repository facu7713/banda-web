{% extends 'base_admin.html.twig' %}

{% block body %}

    <section class="min-h-screen bg-black text-white px-4 md:px-8 py-10">

        <div class="max-w-2xl mx-auto">

            <!-- VOLVER -->
            <a href="{{ path('admin_show') }}"
                class="text-purple-400 hover:text-purple-300 transition mb-6 inline-block">
                ← Volver a shows
            </a>

            <!-- TITULO -->
            <h1 class="text-3xl md:text-4xl font-bold mb-8">
                Nuevo Show
            </h1>

            <!-- FORM -->
            <div class="bg-gray-900 p-6 rounded-xl shadow-lg border border-gray-800">

                {{ form_start(form) }}

                    <!-- EVENTO -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">Evento</label>
                        {{ form_widget(form.evento, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- LUGAR -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">Lugar</label>
                        {{ form_widget(form.lugar, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- CIUDAD -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">Ciudad</label>
                        {{ form_widget(form.ciudad, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- FECHA -->
                    <div class="mb-6">
                        <label class="block mb-2 text-sm text-gray-400">Fecha</label>
                        {{ form_widget(form.fecha, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- BOTÓN -->
                    <button
                        class="w-full bg-gradient-to-r from-purple-500 to-pink-500 py-3 rounded-lg font-semibold text-lg hover:scale-105 transition-all duration-300 shadow-lg">
                        Guardar Show
                    </button>

                {{ form_end(form) }}

            </div>

        </div>

    </section>

{% endblock %}