{% extends 'base_admin.html.twig' %}

{% block body %}

    <section class="min-h-screen bg-black text-white px-4 md:px-8 py-10">

        <div class="max-w-2xl mx-auto">

            <!-- VOLVER -->
            <a href="{{ path('admin_foto') }}"
            class="text-purple-400 hover:text-purple-300 transition mb-6 inline-block">
                ← Volver a fotos
            </a>

            <!-- TITULO -->
            <h1 class="text-3xl md:text-4xl font-bold mb-8">
                Editar Foto
            </h1>

            <!-- CARD -->
            <div class="bg-gray-900 p-6 rounded-xl shadow-lg border border-gray-800">

                {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}

                    <!-- 📸 IMAGEN ACTUAL -->
                    {% if foto.imagen %}
                        <div class="mb-6 text-center">
                            <p class="text-gray-400 text-sm mb-2">Imagen actual</p>
                            <img src="{{ asset('uploads/fotos/' ~ foto.imagen) }}"
                                class="w-full max-h-64 object-cover rounded-lg border border-gray-700 shadow">
                        </div>
                    {% endif %}

                    <!-- NOMBRE -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">Nombre</label>
                        {{ form_widget(form.nombre, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- REEMPLAZAR IMAGEN -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">
                            Reemplazar imagen (opcional)
                        </label>
                        {{ form_widget(form.imagen, {
                            attr: {
                                class: 'w-full text-sm text-gray-300 file:bg-purple-600 file:border-0 file:px-4 file:py-2 file:rounded-lg file:text-white hover:file:bg-purple-700'
                            }
                        }) }}
                    </div>

                    <!-- INFO -->
                    <div class="mb-5">
                        <label class="block mb-2 text-sm text-gray-400">Descripción</label>
                        {{ form_widget(form.info, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- CATEGORIA -->
                    <div class="mb-6">
                        <label class="block mb-2 text-sm text-gray-400">Categoría</label>
                        {{ form_widget(form.categoria, {
                            attr: {
                                class: 'w-full p-3 rounded-lg bg-black border border-gray-700 focus:outline-none focus:border-purple-500'
                            }
                        }) }}
                    </div>

                    <!-- BOTON -->
                    <button
                        class="w-full bg-gradient-to-r from-purple-500 to-pink-500 py-3 rounded-lg font-semibold text-lg hover:scale-105 transition-all duration-300 shadow-lg">
                        Guardar Cambios
                    </button>

                {{ form_end(form) }}

            </div>

        </div>

    </section>

{% endblock %}